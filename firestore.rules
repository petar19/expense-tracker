rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userEmail() { return request.auth.token.email.lower(); }
    function isAllowed() {
      return isSignedIn() && exists(/databases/$(database)/documents/allowedUsers/$(userEmail()));
    }
    function isSiteAdmin() {
      return isAllowed() && get(/databases/$(database)/documents/allowedUsers/$(userEmail())).data.role == 'admin';
    }

    match /allowedUsers/{email} {
      allow read: if isAllowed();
      allow create, update, delete: if isSiteAdmin();
    }

    match /users/{uid} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isAllowed();
      allow create, update, delete: if isAllowed();
    }

    match /groups/{groupId} {
      // Checks memberUids (not the members map) so this matches the array-contains
      // query the app uses to list "my groups" — Firestore can only verify a query
      // is rule-safe when the rule reads the same field the query filters on.
      function isMember() { return isAllowed() && request.auth.uid in resource.data.memberUids; }
      function isGroupAdmin() { return isAllowed() && resource.data.members[request.auth.uid].role == 'admin'; }

      allow read: if isMember();
      allow create: if isAllowed()
        && request.resource.data.members[request.auth.uid].role == 'admin'
        && request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if isGroupAdmin();

      match /expenses/{expenseId} {
        function group() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function isGroupMember() { return isAllowed() && request.auth.uid in group().members; }

        allow read: if isGroupMember();
        allow create: if isGroupMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.paidBy in group().members
          && request.resource.data.price is number && request.resource.data.price > 0
          && (request.resource.data.source != 'migrated' || isSiteAdmin());
        allow update: if isGroupMember() && request.resource.data.paidBy in group().members;
        allow delete: if isGroupMember();
      }

      match /knownNames/{nameId} {
        function isGroupMember() { return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members; }
        allow read, write: if isGroupMember();
      }

      match /nameAliases/{aliasId} {
        function isGroupMember() { return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members; }
        allow read, write: if isGroupMember();
      }

      match /migrationRuns/{runId} {
        function isGroupMember() { return isAllowed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members; }
        allow read, write: if isGroupMember() && isSiteAdmin();
      }
    }
  }
}
